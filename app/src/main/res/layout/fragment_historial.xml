<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    tools:context=".HistorialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFiltroFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/historial_filtro_todo"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltrarFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_filtrar_fecha" />

            <Button
                android:id="@+id/btnLimpiarFiltroFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/historial_limpiar_filtro" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBorrarHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/historial_borrar" />

        <TextView
            android:id="@+id/tvEstadoHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historial_vacio"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/historialContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
