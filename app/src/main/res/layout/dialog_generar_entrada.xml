<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generar_entrada"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proveedor_hint"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/productos_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSeleccionarGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seleccionar_grupo"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNuevoGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nuevo_grupo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvProductosSeleccionadosEntrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historial_vacio"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerResumenEntrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resumen_movimiento"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarEntrada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/cancelar" />

            <Button
                android:id="@+id/btnConfirmarEntrada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/confirmar" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>