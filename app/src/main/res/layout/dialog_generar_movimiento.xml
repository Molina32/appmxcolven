<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generar_movimiento"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/etSolicitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/solicitante_hint"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/area_hint"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/motivo_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/productos_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnEscanearCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/escanear_codigo"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnBuscarArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buscar_articulo"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvProductosSeleccionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay productos seleccionados"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnVerResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resumen_movimiento"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarMovimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/cancelar" />

            <Button
                android:id="@+id/btnConfirmarMovimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/confirmar" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>